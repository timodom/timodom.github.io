{
  "permissions": {
    "deny": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Read(./.obsidian/**)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /FULL/PATH/TO/maps/scripts/build_data.py > /dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}

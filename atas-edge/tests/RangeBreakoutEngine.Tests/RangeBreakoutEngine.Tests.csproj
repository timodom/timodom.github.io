<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness: runs the pure engine on synthetic ES 5m bars. No ATAS needed.
       Run with dotnet run, pointing the project option at this folder. Exit code = number of failures. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Edge.Indicators\Core\RangeBreakoutEngine.cs" Link="RangeBreakoutEngine.cs" />
  </ItemGroup>

</Project>

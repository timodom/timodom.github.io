<Project Sdk="Microsoft.NET.Sdk">

  <!-- MARKET edition of the range breakout bot: same source as the in-house bot
       (Edge.Strategies/OpeningRangeBot.cs) built with MARKET defined, so the validated setup is
       locked, settings are reduced and unsupported charts are refused. Ships as its own DLL, with no
       trail manager or research tools. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>OpeningRange.Market</RootNamespace>
    <AssemblyName>OpeningRangeBot</AssemblyName>
    <DefineConstants>$(DefineConstants);MARKET</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ATAS_BASE Condition=" '$(ATAS_BASE)' == '' ">C:\Program Files (x86)\ATAS Platform</ATAS_BASE>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Edge.Strategies\OpeningRangeBot.cs" Link="OpeningRangeBot.cs" />
    <Compile Include="..\Edge.Indicators\GlobalUsings.cs" Link="Shared\GlobalUsings.cs" />
    <Compile Include="..\Edge.Indicators\Core\BarMath.cs" Link="Shared\BarMath.cs" />
    <Compile Include="..\Edge.Indicators\Core\DragPanel.cs" Link="Shared\DragPanel.cs" />
    <Compile Include="..\Edge.Indicators\Core\Calcs.cs" Link="Shared\Calcs.cs" />
    <Compile Include="..\Edge.Indicators\Core\RangeBreakoutEngine.cs" Link="Shared\RangeBreakoutEngine.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators"><HintPath>$(ATAS_BASE)\ATAS.Indicators.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(ATAS_BASE)\ATAS.DataFeedsCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(ATAS_BASE)\OFT.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Rendering"><HintPath>$(ATAS_BASE)\OFT.Rendering.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(ATAS_BASE)\Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToAtas" AfterTargets="Build" Condition=" '$(OS)' == 'Windows_NT' ">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(APPDATA)\ATAS\Indicators" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research-only tools, kept out of the bot DLL. Builds Edge.Atas.Research.dll into ATAS's
       indicators folder; reload indicators in ATAS to pick it up. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Edge.Atas</RootNamespace>
    <AssemblyName>Edge.Atas.Research</AssemblyName>
    <ATAS_BASE Condition=" '$(ATAS_BASE)' == '' ">C:\Program Files (x86)\ATAS Platform</ATAS_BASE>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators"><HintPath>$(ATAS_BASE)\ATAS.Indicators.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(ATAS_BASE)\ATAS.DataFeedsCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(ATAS_BASE)\OFT.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(ATAS_BASE)\Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToAtas" AfterTargets="Build" Condition=" '$(OS)' == 'Windows_NT' ">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(APPDATA)\ATAS\Indicators" />
  </Target>

</Project>
